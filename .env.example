# Copy this file to .env and fill in your own values.
# .env is gitignored. Do not commit it or paste the values into chat.

# Neon pooled connection string from the project dashboard.
# It looks like postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# On Vercel, set this same name in Project Settings → Environment Variables.
# Use the pooled host (the hostname contains -pooler), not the direct host.
DATABASE_URL=

# Password for the staff page at /admin. Choose at least 12 characters.
ADMIN_PASSWORD=

# Random string used to sign the staff session cookie. Choose at least 24 characters.
SESSION_SECRET=

# API port. The Vite dev server proxies /api to this port.
PORT=3001
